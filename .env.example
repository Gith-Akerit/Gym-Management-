PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/gym.sqlite
APP_ORIGIN=http://localhost:5173
# Only docker-compose reads this: the domain Caddy gets a certificate for.
# Point its DNS A record at the server first. See docs/deploy.md.
APP_DOMAIN=
# Number of reverse proxies in front of the app, so req.ip is the caller and not
# the proxy. 1 for a single nginx/Caddy/Cloudflare hop; 0 only when nothing
# fronts the app. Getting this wrong makes the whole gym share one rate limit.
TRUST_PROXY=1
NODE_ENV=development
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Configure a local SMTP inbox for development; production requires authenticated TLS SMTP.
# Any standard SMTP provider works. For Brevo's free tier (300 a day):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=<the login Brevo shows>  SMTP_PASSWORD=<the SMTP key, not the website password>
# MAIL_FROM must be an address the provider has verified, and must not be a free
# mailbox like @gmail.com -- Gmail's own DMARC policy will have it rejected.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=gym@example.test
# Guard for npm run db:rollback. Leave empty; set to "yes" only for the single
# command you intend to run, and back up the .sqlite file first — rolling back
# drops the gym profile, opening hours and packages (members are untouched).
ALLOW_DESTRUCTIVE_ROLLBACK=
# Used only by db:admin. No role can be elevated through public APIs.
ADMIN_EMAIL=
# PromptPay account that receives payments: Thai mobile number, 13 digit national
# ID, or 15 digit e-Wallet ID. This is the owner's personal identifier — keep it
# out of the repository and out of logs.
PROMPTPAY_ID=
# Slip images. Must NOT be inside a directory served as static files.
SLIP_STORAGE_PATH=./data/slips
# How long slip images are kept before npm run slips:prune deletes them.
SLIP_RETENTION_DAYS=365
