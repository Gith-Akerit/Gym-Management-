PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/gym.sqlite
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Configure a local SMTP inbox for development; production requires authenticated TLS SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=gym@example.test
# Used only by db:admin. No role can be elevated through public APIs.
ADMIN_EMAIL=
# PromptPay account that receives payments: Thai mobile number, 13 digit national
# ID, or 15 digit e-Wallet ID. This is the owner's personal identifier — keep it
# out of the repository and out of logs.
PROMPTPAY_ID=
# Slip images. Must NOT be inside a directory served as static files.
SLIP_STORAGE_PATH=./data/slips
