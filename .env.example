PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/gym.sqlite
APP_ORIGIN=http://localhost:5173
# Only docker-compose reads this: the domain Caddy gets a certificate for.
# Point its DNS A record at the server first. See docs/deploy.md.
APP_DOMAIN=
# Number of reverse proxies in front of the app, so req.ip is the caller and not
# the proxy. 1 for a single nginx/Caddy/Cloudflare hop; 0 only when nothing
# fronts the app. Getting this wrong makes the whole gym share one rate limit.
TRUST_PROXY=1
NODE_ENV=development
# Pilot mode: run the counter before the gym has a PromptPay account. Packages
# are sold and handed over at the desk. Set to 1 to turn on; delete the line to
# go live. Everything created while it is on keeps working afterwards.
PILOT_MODE=
# Signs the QR on every membership card, and the sessions staff sign in with.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it afterwards: every card the gym has already sent out stops
# scanning, and everybody is signed out. (Called OTP_SECRET before the card
# existed; the old name is still read, with a warning, so an installed gym
# keeps working across the upgrade.)
CARD_SIGNING_SECRET=
# Guard for npm run db:rollback. Leave empty; set to "yes" only for the single
# command you intend to run, and back up the .sqlite file first — rolling back
# drops the gym profile, opening hours and packages (members are untouched).
ALLOW_DESTRUCTIVE_ROLLBACK=
# The first administrator, used only by db:admin and by the first boot after an
# install. Both are cleared from the file afterwards; from then on accounts are
# managed on the "ผู้ใช้และสิทธิ์" screen. To give an existing account a
# password without signing in: npm run admin:set-password-link -- <email>
ADMIN_EMAIL=
ADMIN_PASSWORD=
# PromptPay account that receives payments: Thai mobile number, 13 digit national
# ID, or 15 digit e-Wallet ID. This is the owner's personal identifier — keep it
# out of the repository and out of logs. Leave empty while PILOT_MODE=1.
PROMPTPAY_ID=
# Slip images and member photographs. Neither may be inside a directory served
# as static files: both are personal data handed out only to a signed-in staff
# member, through a route that checks who is asking.
SLIP_STORAGE_PATH=./data/slips
PHOTO_STORAGE_PATH=./data/photos
# The gym own logo, uploaded by the owner on the settings screen. Unlike the
# two above it is not personal data -- it is served to the login screen before
# anybody has signed in -- but it still has to sit on the persistent disk and
# be in the backup set, or every card comes back without it after a restore.
LOGO_STORAGE_PATH=./data/logo
# How long slip images are kept before npm run slips:prune deletes them.
SLIP_RETENTION_DAYS=365
