{
  "name": "gym-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env server/manage.js migrate",
    "db:rollback": "node --env-file-if-exists=.env server/manage.js rollback",
    "db:seed": "node --env-file-if-exists=.env server/manage.js seed",
    "db:admin": "node --env-file-if-exists=.env server/manage.js admin",
    "db:seed:demo": "node --env-file-if-exists=.env server/manage.js seed:demo"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "smtp-server": "^3.19.12",
    "supertest": "^7.2.2",
    "vite": "^8.3.0"
  }
}
